# Copy to .env, fill in, then: chmod 600 .env  (and keep it out of git).
# Generate every secret with:  openssl rand -hex 24  (48 hex chars), EXCEPT the
# lake S3 key pair below, which has shorter limits. `make env` does all of this.
# Hex keeps values safe inside URLs, JSON and shell.

# --- Image versions (always pinned, never "latest") ---
RUSTFS_VERSION=1.0.0
RC_VERSION=v0.1.36
LAKEKEEPER_VERSION=v0.13.1
CURL_VERSION=8.22.0

# --- RustFS root (used only by rustfs and storage-init) ---
RUSTFS_ROOT_USER=
RUSTFS_ROOT_PASSWORD=

# --- Lake bucket and its bucket-scoped access key ---
# RustFS enforces the S3/MinIO-compatible limits on service accounts: access key 3-20 chars,
# secret key 8-40 chars. A 48-char secret makes storage-init fail with
# "InvalidArgument: invalid secret key length" (observed 2026-10-07). Generate with:
#   LAKE_S3_ACCESS_KEY -> openssl rand -hex 10   (20 chars)
#   LAKE_S3_SECRET_KEY -> openssl rand -hex 20   (40 chars)
LAKE_BUCKET=lake
LAKE_S3_REGION=local-01
LAKE_S3_ACCESS_KEY=
LAKE_S3_SECRET_KEY=

# --- Warehouse (Lakekeeper) ---
LAKE_WAREHOUSE=lake
# Back this key up outside the host: it decrypts the credentials stored in the catalog.
LAKEKEEPER_ENCRYPTION_KEY=

# --- Postgres (one instance: databases "catalog" and "jobs") ---
PG_ADMIN_USER=lake_admin
PG_ADMIN_PASSWORD=
CATALOG_DB_PASSWORD=
JOBS_WORKER_PASSWORD=

# --- Resource limits (optional; defaults shown) ---
# WORKER_MEM_LIMIT=2g
# WORKER_POOL_MB=1400
# WORKER_CPUS=2
# QUERY_MEM_LIMIT=4g
# QUERY_POOL_MB=2800
# QUERY_CPUS=4
